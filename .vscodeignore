# Build output: only the bundles and their runtime assets ship. vsce applies the `!`
# re-includes after every exclusion, whatever their order, so they name exact file types:
# `!out/webview/**` would bring back the source maps of a `--sourcemap` build.
# out/: not the per-module output of the test build (`npm run compile-tests`).
out/**
!out/extension.js
!out/grammars/**/*.json
!out/webview/*.js
!out/webview/*.css
# server/: the language server bundle only — not its sources, tests, coverage report
# or .c8_output (the release workflow runs the server's coverage before packaging).
server/**
!server/out/server.js
# The standalone LSP and MCP bundles are separate release assets; MCP sources and tests.
dist/**
mcp/**

# Source files
.vscode/**
.vscode-test/**
src/**
.gitignore
.yarnrc
tsconfig.json
esbuild.js
vsc-extension-quickstart.md

# Development dependencies
**/tsconfig.json
**/.eslintrc.json
**/*.map
**/*.ts

# Documentation (keep README and CHANGELOG)
CONTRIBUTING.md
DITA-OT-INTEGRATION.md
COMMANDS-AND-SHORTCUTS.md
CONFIGURATION.md
PROJECT-SUMMARY.md
project-ditacraft.md
DEBUGGING-GUIDE.md
INSTALL-LOCAL.md
PHASE1-COMPLETE.md
VALIDATION-TESTS.md
VALIDATOR-IMPLEMENTATION.md

# Build artifacts
.vscode-test/
out/test/
out/commands/
out/providers/
out/utils/
# Visual preview: keep out/grammars/ and out/webview/ (runtime assets); drop the
# tsc test-build output of the bundled modules and the grammar build tool.
out/shared/
out/preview/
out/editor/
out/properties/
out/tools/
webview/**
tsconfig.webview.json

# Node modules (all dependencies are bundled by esbuild)
node_modules/**
server/node_modules/**
server/package.json
server/package-lock.json

# Git
.git
.gitignore
.github

# Testing & Coverage
coverage
.nyc_output
.c8_output/**
**/*.test.ts
**/*.spec.ts

# IDE
.DS_Store
.idea

# Misc
*.vsix
.claude/
.ditacraft/
test-minimal/
NUL
nul
add-missing-data.png
*.png
!resources/*.png
!resources/ditacraft-activity.svg
# The user guide cover's traced logo (scripts/cover/): not used by the extension.
resources/ditacraft-logo.svg

# Development files
AGENTS.md
CLAUDE.md
TEST_PLAN.md
okf.toml
eslint.config.mjs
esbuild-standalone.js
.graphifyignore
.cspellrc.json
.c8rc.json
test-workspace/**

# Development docs (not needed in production)
docs/**
workspace_ditacraft/**
scripts/**
ANALYSIS_SUMMARY.txt
IMPROVEMENT_PLAN.md
ARCHITECTURE.md
