{
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "out",
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": [
    "src/**/*",
    "../server/src/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
