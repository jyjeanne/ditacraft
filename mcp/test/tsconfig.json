{
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "../out/test",
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "composite": false,
    "declaration": false,
    "sourceMap": true,
    "types": ["mocha", "node"],
    "typeRoots": [
      "../../node_modules/@types",
      "../../server/node_modules/@types",
      "../../server/node_modules",
      "../node_modules/@types"
    ],
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "**/*.ts",
    "../src/**/*.ts",
    "../../server/src/**/*.ts",
    "../../server/src/**/*.json"
  ],
  "exclude": [
    "node_modules",
    "debug-test.ts",
    "smoke-test.ts"
  ]
}
