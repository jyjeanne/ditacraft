{
  "name": "ditacraft",
  "displayName": "DitaCraft",
  "description": "Best way to edit and publish your DITA files - Complete DITA editing and publishing solution for VS Code",
  "version": "0.9.1",
  "publisher": "JeremyJeanne",
  "author": {
    "name": "Jeremy Jeanne",
    "email": "jyjeanne@gmail.com"
  },
  "license": "MIT",
  "icon": "resources/ditacraft-logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jyjeanne/ditacraft"
  },
  "bugs": {
    "url": "https://github.com/jyjeanne/ditacraft/issues"
  },
  "homepage": "https://github.com/jyjeanne/ditacraft#readme",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Other"
  ],
  "keywords": [
    "dita",
    "xml",
    "technical-writing",
    "documentation",
    "publishing",
    "dita-ot",
    "bookmap",
    "ditamap"
  ],
  "activationEvents": [
    "onLanguage:dita",
    "onCommand:ditacraft.validate",
    "onCommand:ditacraft.publish",
    "onCommand:ditacraft.newTopic",
    "onCommand:ditacraft.newMap",
    "onCommand:ditacraft.newBookmap",
    "onCommand:ditacraft.configureDitaOT",
    "workspaceContains:**/*.dita",
    "workspaceContains:**/*.ditamap",
    "workspaceContains:**/*.bookmap",
    "onView:ditacraft.ditaExplorer",
    "onView:ditacraft.keySpaceView",
    "onView:ditacraft.diagnosticsView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "ditacraft",
        "name": "ditacraft",
        "description": "DitaCraft AI assistant for DITA documentation — restructure maps, explain errors, and more.",
        "isSticky": true,
        "commands": [
          {
            "name": "restructure",
            "description": "Propose a restructured DITA map based on your intention"
          },
          {
            "name": "validate",
            "description": "Explain a DITA validation error in plain language"
          },
          {
            "name": "explain",
            "description": "Explain the semantic structure of the selected DITA element"
          },
          {
            "name": "suggest-reuse",
            "description": "Identify conref/keyref reuse opportunities in the current DITA map"
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "dita",
        "aliases": [
          "DITA",
          "dita"
        ],
        "extensions": [
          ".dita",
          ".ditamap",
          ".bookmap",
          ".ditaval"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dita",
        "scopeName": "text.xml.dita",
        "path": "./syntaxes/dita.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ditacraft-explorer",
          "title": "DitaCraft",
          "icon": "resources/ditacraft-activity.svg"
        }
      ]
    },
    "views": {
      "ditacraft-explorer": [
        {
          "id": "ditacraft.ditaExplorer",
          "name": "DITA Explorer"
        },
        {
          "id": "ditacraft.keySpaceView",
          "name": "Key Space",
          "visibility": "collapsed"
        },
        {
          "id": "ditacraft.diagnosticsView",
          "name": "Diagnostics",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ditacraft.ditaExplorer",
        "contents": "No DITA maps found in the workspace.\n[Create a New Map](command:ditacraft.newMap)\n[Create a New Bookmap](command:ditacraft.newBookmap)",
        "when": "workspaceFolderCount > 0"
      },
      {
        "view": "ditacraft.ditaExplorer",
        "contents": "Open a folder containing DITA files to get started.\n[Open Folder](command:vscode.openFolder)",
        "when": "workspaceFolderCount == 0"
      },
      {
        "view": "ditacraft.keySpaceView",
        "contents": "No keys found.\nOpen a workspace containing DITA maps with key definitions."
      },
      {
        "view": "ditacraft.diagnosticsView",
        "contents": "No DITA diagnostics.\nAll files are clean."
      }
    ],
    "commands": [
      {
        "command": "ditacraft.validate",
        "title": "DITA: Validate Current File",
        "icon": "$(check)"
      },
      {
        "command": "ditacraft.publish",
        "title": "DITA: Publish (Select Format)",
        "icon": "$(export)"
      },
      {
        "command": "ditacraft.publishHTML5",
        "title": "DITA: Publish to HTML5",
        "icon": "$(globe)"
      },
      {
        "command": "ditacraft.managePublishingProfiles",
        "title": "DITA: Manage Publishing Profiles"
      },
      {
        "command": "ditacraft.previewHTML5",
        "title": "DITA: Preview HTML5",
        "icon": "$(open-preview)"
      },
      {
        "command": "ditacraft.previewFilter",
        "title": "DITA: Set Preview DITAVAL Filter",
        "icon": "$(filter)"
      },
      {
        "command": "ditacraft.newTopic",
        "title": "DITA: Create New Topic"
      },
      {
        "command": "ditacraft.newMap",
        "title": "DITA: Create New Map"
      },
      {
        "command": "ditacraft.newBookmap",
        "title": "DITA: Create New Bookmap"
      },
      {
        "command": "ditacraft.initProject",
        "title": "DITA: Initialize DITA Project"
      },
      {
        "command": "ditacraft.insertImage",
        "title": "DITA: Insert Image",
        "icon": "$(file-media)"
      },
      {
        "command": "ditacraft.insertTable",
        "title": "DITA: Insert Table",
        "icon": "$(table)"
      },
      {
        "command": "ditacraft.findReplaceInFiles",
        "title": "DITA: Find and Replace in Files",
        "icon": "$(replace-all)"
      },
      {
        "command": "ditacraft.batchUpdateMetadata",
        "title": "DITA: Batch Update Metadata",
        "icon": "$(list-flat)"
      },
      {
        "command": "ditacraft.editDitavalConditions",
        "title": "DITA: Edit DITAVAL Conditions",
        "icon": "$(filter)"
      },
      {
        "command": "ditacraft.extractTopicFromSection",
        "title": "DITA: Extract Topic from Section",
        "icon": "$(export)"
      },
      {
        "command": "ditacraft.startWatchMode",
        "title": "DITA: Start Watch Mode",
        "icon": "$(eye)"
      },
      {
        "command": "ditacraft.stopWatchMode",
        "title": "DITA: Stop Watch Mode",
        "icon": "$(eye-closed)"
      },
      {
        "command": "ditacraft.inlineConref",
        "title": "DITA: Inline Conref",
        "icon": "$(collapse-all)"
      },
      {
        "command": "ditacraft.configureDitaOT",
        "title": "DITA: Configure DITA-OT Path"
      },
      {
        "command": "ditacraft.setupCSpell",
        "title": "DITA: Setup cSpell Configuration (Deprecated - use LSP)"
      },
      {
        "command": "ditacraft.showLogFile",
        "title": "DITA: Show Log File Location"
      },
      {
        "command": "ditacraft.openLogFile",
        "title": "DITA: Open Log File"
      },
      {
        "command": "ditacraft.showOutputChannel",
        "title": "DITA: Show Output Channel"
      },
      {
        "command": "ditacraft.clearOutputChannel",
        "title": "DITA: Clear Output Channel"
      },
      {
        "command": "ditacraft.showBuildOutput",
        "title": "DITA: Show Build Output"
      },
      {
        "command": "ditacraft.showMapVisualizer",
        "title": "DITA: Show Map Visualizer",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "ditacraft.testLogger",
        "title": "DITA: Test Logger (Debug)"
      },
      {
        "command": "ditacraft.openFile",
        "title": "DITA: Open File"
      },
      {
        "command": "ditacraft.refreshDitaExplorer",
        "title": "DITA: Refresh Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "ditacraft.refreshKeySpace",
        "title": "DITA: Refresh Key Space",
        "icon": "$(refresh)"
      },
      {
        "command": "ditacraft.refreshDiagnosticsView",
        "title": "DITA: Refresh Diagnostics",
        "icon": "$(refresh)"
      },
      {
        "command": "ditacraft.diagnosticsGroupByFile",
        "title": "Group by File",
        "icon": "$(group-by-ref-type)"
      },
      {
        "command": "ditacraft.diagnosticsGroupByType",
        "title": "Group by Severity",
        "icon": "$(symbol-enum)"
      },
      {
        "command": "ditacraft.setRootMap",
        "title": "DITA: Set Root Map"
      },
      {
        "command": "ditacraft.clearRootMap",
        "title": "DITA: Clear Root Map (Auto-Discover)"
      },
      {
        "command": "ditacraft.validateWorkspace",
        "title": "DITA: Validate Workspace"
      },
      {
        "command": "ditacraft.validateGuide",
        "title": "DITA: Validate Entire Guide Using DITA-OT"
      },
      {
        "command": "ditacraft.configureAI",
        "title": "DitaCraft: Configure AI Settings",
        "category": "DitaCraft"
      },
      {
        "command": "ditacraft.restructureMap",
        "title": "DitaCraft: Restructure Active DITA Map",
        "category": "DitaCraft",
        "icon": "$(wand)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ditacraft.restructureMap",
          "when": "resourceExtname == .ditamap || resourceExtname == .bookmap",
          "group": "navigation@4"
        },
        {
          "command": "ditacraft.validate",
          "when": "resourceLangId == dita || resourceExtname == .dita || resourceExtname == .ditamap || resourceExtname == .bookmap",
          "group": "navigation@1"
        },
        {
          "command": "ditacraft.previewHTML5",
          "when": "resourceLangId == dita || resourceExtname == .dita || resourceExtname == .ditamap || resourceExtname == .bookmap",
          "group": "navigation@2"
        },
        {
          "command": "ditacraft.showMapVisualizer",
          "when": "resourceExtname == .ditamap || resourceExtname == .bookmap",
          "group": "navigation@3"
        },
        {
          "command": "ditacraft.publish",
          "when": "resourceLangId == dita || resourceExtname == .dita || resourceExtname == .ditamap || resourceExtname == .bookmap",
          "group": "navigation@4"
        },
        {
          "command": "ditacraft.previewFilter",
          "when": "resourceLangId == dita || resourceExtname == .dita || resourceExtname == .ditamap || resourceExtname == .bookmap",
          "group": "navigation@5"
        },
        {
          "command": "ditacraft.editDitavalConditions",
          "when": "resourceExtname == .ditaval",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "ditacraft.validate",
          "when": "resourceLangId == dita || resourceExtname == .dita || resourceExtname == .ditamap || resourceExtname == .bookmap",
          "group": "ditacraft@1"
        },
        {
          "command": "ditacraft.publish",
          "when": "resourceLangId == dita || resourceExtname == .dita || resourceExtname == .ditamap || resourceExtname == .bookmap",
          "group": "ditacraft@2"
        },
        {
          "command": "ditacraft.insertImage",
          "when": "resourceExtname == .dita || resourceExtname == .ditamap || resourceExtname == .bookmap",
          "group": "ditacraft@3"
        },
        {
          "command": "ditacraft.insertTable",
          "when": "resourceExtname == .dita",
          "group": "ditacraft@4"
        },
        {
          "command": "ditacraft.editDitavalConditions",
          "when": "resourceExtname == .ditaval",
          "group": "ditacraft@5"
        },
        {
          "command": "ditacraft.extractTopicFromSection",
          "when": "resourceExtname == .dita",
          "group": "ditacraft@6"
        },
        {
          "command": "ditacraft.startWatchMode",
          "when": "resourceLangId == dita || resourceExtname == .dita || resourceExtname == .ditamap || resourceExtname == .bookmap",
          "group": "ditacraft@7"
        },
        {
          "command": "ditacraft.inlineConref",
          "when": "resourceExtname == .dita",
          "group": "ditacraft@8"
        }
      ],
      "view/title": [
        {
          "command": "ditacraft.refreshDitaExplorer",
          "when": "view == ditacraft.ditaExplorer",
          "group": "navigation"
        },
        {
          "command": "ditacraft.refreshKeySpace",
          "when": "view == ditacraft.keySpaceView",
          "group": "navigation"
        },
        {
          "command": "ditacraft.refreshDiagnosticsView",
          "when": "view == ditacraft.diagnosticsView",
          "group": "navigation"
        },
        {
          "command": "ditacraft.diagnosticsGroupByFile",
          "when": "view == ditacraft.diagnosticsView",
          "group": "navigation"
        },
        {
          "command": "ditacraft.diagnosticsGroupByType",
          "when": "view == ditacraft.diagnosticsView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ditacraft.validate",
          "when": "view == ditacraft.ditaExplorer && viewItem =~ /ditaFile/",
          "group": "ditacraft@1"
        },
        {
          "command": "ditacraft.publish",
          "when": "view == ditacraft.ditaExplorer && viewItem =~ /ditaMap/",
          "group": "ditacraft@2"
        },
        {
          "command": "ditacraft.showMapVisualizer",
          "when": "view == ditacraft.ditaExplorer && viewItem =~ /ditaMap/",
          "group": "ditacraft@3"
        },
        {
          "command": "ditacraft.batchUpdateMetadata",
          "when": "view == ditacraft.ditaExplorer && viewItem =~ /ditaFile/",
          "group": "ditacraft@4"
        }
      ],
      "commandPalette": [
        {
          "command": "ditacraft.validate",
          "when": "resourceLangId == dita || resourceExtname == .dita || resourceExtname == .ditamap || resourceExtname == .bookmap"
        },
        {
          "command": "ditacraft.publish",
          "when": "resourceLangId == dita || resourceExtname == .dita || resourceExtname == .ditamap || resourceExtname == .bookmap"
        },
        {
          "command": "ditacraft.publishHTML5",
          "when": "resourceLangId == dita || resourceExtname == .dita || resourceExtname == .ditamap || resourceExtname == .bookmap"
        },
        {
          "command": "ditacraft.previewHTML5",
          "when": "resourceLangId == dita || resourceExtname == .dita || resourceExtname == .ditamap || resourceExtname == .bookmap"
        },
        {
          "command": "ditacraft.previewFilter",
          "when": "resourceLangId == dita || resourceExtname == .dita || resourceExtname == .ditamap || resourceExtname == .bookmap"
        },
        {
          "command": "ditacraft.showMapVisualizer",
          "when": "resourceExtname == .ditamap || resourceExtname == .bookmap"
        },
        {
          "command": "ditacraft.editDitavalConditions",
          "when": "resourceExtname == .ditaval"
        },
        {
          "command": "ditacraft.restructureMap",
          "when": "resourceExtname == .ditamap || resourceExtname == .bookmap"
        },
        {
          "command": "ditacraft.insertImage",
          "when": "resourceExtname == .dita || resourceExtname == .ditamap || resourceExtname == .bookmap"
        },
        {
          "command": "ditacraft.insertTable",
          "when": "resourceExtname == .dita"
        },
        {
          "command": "ditacraft.extractTopicFromSection",
          "when": "resourceExtname == .dita"
        },
        {
          "command": "ditacraft.startWatchMode",
          "when": "resourceLangId == dita || resourceExtname == .dita || resourceExtname == .ditamap || resourceExtname == .bookmap"
        },
        {
          "command": "ditacraft.inlineConref",
          "when": "resourceExtname == .dita"
        }
      ],
      "explorer/context": [
        {
          "command": "ditacraft.restructureMap",
          "when": "resourceExtname == .ditamap || resourceExtname == .bookmap",
          "group": "ditacraft@1"
        },
        {
          "command": "ditacraft.editDitavalConditions",
          "when": "resourceExtname == .ditaval",
          "group": "ditacraft@2"
        },
        {
          "command": "ditacraft.startWatchMode",
          "when": "resourceExtname == .ditamap || resourceExtname == .bookmap",
          "group": "ditacraft@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ditacraft.validate",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "resourceLangId == dita || resourceExtname == .dita"
      },
      {
        "command": "ditacraft.previewHTML5",
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+h",
        "when": "resourceLangId == dita || resourceExtname == .dita"
      },
      {
        "command": "ditacraft.publish",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "resourceLangId == dita || resourceExtname == .dita"
      }
    ],
    "configuration": {
      "title": "DitaCraft",
      "properties": {
        "ditacraft.ditaOtPath": {
          "type": "string",
          "default": "",
          "description": "Path to DITA-OT installation directory (e.g., C:\\DITA-OT or /usr/local/dita-ot). Leave empty to use system PATH.",
          "order": 1
        },
        "ditacraft.defaultTranstype": {
          "type": "string",
          "default": "html5",
          "enum": [
            "html5",
            "pdf",
            "xhtml",
            "epub",
            "htmlhelp",
            "markdown"
          ],
          "description": "Default output format for DITA-OT publishing.",
          "order": 2
        },
        "ditacraft.outputDirectory": {
          "type": "string",
          "default": "${workspaceFolder}/out",
          "description": "Directory where published files will be saved. Supports ${workspaceFolder} variable.",
          "order": 3
        },
        "ditacraft.autoValidate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically validate DITA files on save.",
          "order": 4
        },
        "ditacraft.previewAutoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh HTML5 preview when file is saved.",
          "order": 5
        },
        "ditacraft.previewTheme": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "enumDescriptions": [
            "Follow VS Code's current theme",
            "Always use light theme",
            "Always use dark theme"
          ],
          "description": "Theme for the HTML5 preview panel.",
          "order": 6
        },
        "ditacraft.previewCustomCss": {
          "type": "string",
          "default": "",
          "description": "Path to a custom CSS file to apply to the preview. Supports ${workspaceFolder} variable.",
          "order": 7
        },
        "ditacraft.previewScrollSync": {
          "type": "boolean",
          "default": true,
          "description": "Enable bidirectional scroll synchronization between the source editor and HTML5 preview.",
          "order": 8
        },
        "ditacraft.conditionHighlightingEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Dim elements in the editor that the active preview DITAVAL filter (DITA: Set Preview DITAVAL Filter) would exclude from a filtered publish.",
          "order": 46
        },
        "ditacraft.showProgressNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show progress notifications during DITA-OT processing.",
          "order": 8
        },
        "ditacraft.validationEngine": {
          "type": "string",
          "default": "built-in",
          "enum": [
            "built-in",
            "typesxml",
            "xmllint"
          ],
          "enumDescriptions": [
            "Built-in validation with content model checking (no DTD, lightweight)",
            "Full DTD validation using TypesXML (recommended, pure TypeScript)",
            "External xmllint for DTD validation (requires libxml2 installed)"
          ],
          "description": "XML validation engine. TypesXML provides full DTD validation. Built-in provides content model checking without full DTD.",
          "order": 9
        },
        "ditacraft.ditaOtArgs": {
          "type": "array",
          "default": [],
          "description": "Additional command-line arguments to pass to DITA-OT (e.g., ['--verbose', '--filter=myfilter.ditaval']).",
          "order": 10
        },
        "ditacraft.enableSnippets": {
          "type": "boolean",
          "default": true,
          "description": "Enable DITA code snippets and auto-completion.",
          "order": 11
        },
        "ditacraft.logLevel": {
          "type": "string",
          "default": "info",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "description": "Logging level for debugging. Set to 'debug' to enable detailed logging.",
          "order": 12
        },
        "ditacraft.enableFileLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable logging to file in system temp directory. Only active when logLevel is set to 'debug'.",
          "order": 13
        },
        "ditacraft.enableConsoleLogging": {
          "type": "boolean",
          "default": true,
          "description": "Enable logging to Output channel in VS Code.",
          "order": 14
        },
        "ditacraft.validationDebounceMs": {
          "type": "number",
          "default": 500,
          "minimum": 100,
          "maximum": 2000,
          "description": "Debounce delay (in milliseconds) before validating a file after changes. Lower values provide faster feedback but may impact performance.",
          "order": 15
        },
        "ditacraft.keySpaceCacheTtlMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 30,
          "description": "Time-to-live (in minutes) for cached key space data. Increase for better performance with large DITA projects.",
          "order": 16
        },
        "ditacraft.ditaOtTimeoutMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "maximum": 30,
          "description": "Maximum time (in minutes) to wait for DITA-OT processing to complete before timing out.",
          "order": 17
        },
        "ditacraft.maxLinkMatches": {
          "type": "number",
          "default": 10000,
          "minimum": 1000,
          "maximum": 100000,
          "description": "Maximum number of link matches to process per file. Increase for very large DITA files.",
          "order": 18
        },
        "ditacraft.maxNumberOfProblems": {
          "type": "number",
          "default": 100,
          "minimum": 10,
          "maximum": 1000,
          "description": "Maximum total number of diagnostics reported per file.",
          "order": 19
        },
        "ditacraft.ditaRulesEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable DITA authoring rules validation (deprecated elements, accessibility, style recommendations).",
          "order": 20
        },
        "ditacraft.ditaRulesCategories": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mandatory",
              "recommendation",
              "authoring",
              "accessibility"
            ]
          },
          "default": [
            "mandatory",
            "recommendation",
            "authoring",
            "accessibility"
          ],
          "description": "Which DITA rule categories to enable. Mandatory: required by spec. Recommendation: best practices. Authoring: content quality. Accessibility: alt text, descriptions.",
          "order": 21
        },
        "ditacraft.crossRefValidationEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Validate href, conref, keyref, and conkeyref targets (checks that referenced files and IDs exist).",
          "order": 22
        },
        "ditacraft.subjectSchemeValidationEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable subject scheme controlled value validation. When a subject scheme map constrains profiling attributes, validates that only allowed values are used.",
          "order": 23
        },
        "ditacraft.validationSeverityOverrides": {
          "type": "object",
          "default": {},
          "description": "Override the severity of specific diagnostic rules. Keys are diagnostic codes (e.g. 'DITA-SCH-016'), values are 'error', 'warning', 'information', 'hint', or 'off' to suppress.",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "information",
              "hint",
              "off"
            ]
          },
          "order": 24
        },
        "ditacraft.largeFileThresholdKB": {
          "type": "number",
          "default": 500,
          "minimum": 0,
          "description": "File size threshold (KB) above which heavy validation phases (DITA rules, cross-references, circular refs, workspace checks, custom rules) are skipped for performance. Set to 0 to disable.",
          "order": 25
        },
        "ditacraft.customRulesFile": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a JSON file containing custom validation rules. Each rule has: id, pattern (regex), severity (error/warning/information/hint), message, and optional fileTypes array (topic, concept, task, reference, glossentry, troubleshooting, map, bookmap).",
          "order": 25
        },
        "ditacraft.rootMap": {
          "type": "string",
          "default": "",
          "description": "Explicit root map path (relative to workspace root). Leave empty for automatic discovery. Set via 'DITA: Set Root Map' command.",
          "order": 25
        },
        "ditacraft.xmlCatalogPath": {
          "type": "string",
          "default": "",
          "description": "Path to an external OASIS XML catalog file for custom DTD resolution. Enables validation of custom DITA specializations. Leave empty to use the bundled DITA 1.2/1.3/2.0 catalogs.",
          "order": 25
        },
        "ditacraft.ditaVersion": {
          "type": "string",
          "enum": [
            "auto",
            "1.0",
            "1.1",
            "1.2",
            "1.3",
            "2.0"
          ],
          "default": "auto",
          "description": "Override auto-detected DITA version. Set to 'auto' to detect from @DITAArchVersion attribute or DOCTYPE declaration.",
          "order": 26
        },
        "ditacraft.schemaFormat": {
          "type": "string",
          "enum": [
            "dtd",
            "rng"
          ],
          "default": "dtd",
          "description": "Schema format for validation. 'dtd' uses TypesXML with OASIS catalog (recommended). 'rng' uses RelaxNG validation via salve-annos (requires rngSchemaPath).",
          "order": 27
        },
        "ditacraft.rngSchemaPath": {
          "type": "string",
          "default": "",
          "description": "Path to directory containing RelaxNG (.rng) schema files. Required when schemaFormat is set to 'rng'. Example: path to DITA-OT's schema directory.",
          "order": 28
        },
        "ditacraft.cspellAutoPrompt": {
          "type": "boolean",
          "default": false,
          "description": "Automatically suggest cSpell DITA dictionary setup when cSpell is installed but not configured. The 'DITA: Setup cSpell Configuration' command is always available regardless of this setting.",
          "order": 29
        },
        "ditacraft.ai.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable all DitaCraft AI features. When disabled, the LSP validation, navigation, and publishing features remain fully functional.",
          "order": 30
        },
        "ditacraft.ai.mode": {
          "type": "string",
          "enum": [
            "auto",
            "copilot-only",
            "byok-only",
            "local-only"
          ],
          "enumDescriptions": [
            "Automatically select the best available provider (Copilot first, then BYOK, then Ollama).",
            "Only use GitHub Copilot. Requires an active Copilot subscription.",
            "Only use a user-supplied API key (Anthropic, OpenAI). Skips Copilot.",
            "Only use a local Ollama server. No data is sent to external services."
          ],
          "default": "auto",
          "description": "LLM provider selection strategy for DitaCraft AI features.",
          "order": 31
        },
        "ditacraft.ai.provider.anthropic.model": {
          "type": "string",
          "default": "claude-3-5-sonnet-20241022",
          "description": "Anthropic Claude model to use when a BYOK Anthropic API key is configured.",
          "order": 32
        },
        "ditacraft.ai.provider.openai.model": {
          "type": "string",
          "default": "gpt-4o",
          "description": "OpenAI model to use when a BYOK OpenAI API key is configured.",
          "order": 33
        },
        "ditacraft.ai.provider.ollama.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Base URL for the local Ollama server (local-only / air-gapped mode).",
          "order": 34
        },
        "ditacraft.ai.provider.ollama.model": {
          "type": "string",
          "default": "llama3",
          "description": "Ollama model name to use (e.g. llama3, mistral, codellama).",
          "order": 35
        },
        "ditacraft.ai.context.maxTokens": {
          "type": "number",
          "default": 8000,
          "minimum": 1000,
          "maximum": 128000,
          "description": "Maximum number of tokens to use for the DITA context injected into LLM prompts.",
          "order": 36
        },
        "ditacraft.ai.quickfix.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show an AI-powered quick fix option alongside standard LSP quick fixes for DITA diagnostics.",
          "order": 37
        },
        "ditacraft.ai.streaming.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Stream LLM responses progressively in Copilot Chat (requires streaming-capable provider).",
          "order": 38
        },
        "ditacraft.ai.telemetry.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Send anonymised usage metrics (latency, success/failure rates) to the DitaCraft team. No document content or personal data is included.",
          "order": 39
        },
        "ditacraft.ai.completion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable AI-enriched DITA completions (F4). When enabled, DitaCraft requests AI suggestions if fewer than 3 native completions are available. Non-blocking: abandoned after 500ms.",
          "order": 40
        },
        "ditacraft.ai.provider.ollama.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Include Ollama as a fallback LLM provider (local inference). Requires Ollama to be running on the configured base URL.",
          "order": 41
        },
        "ditacraft.publishingProfiles": {
          "type": "array",
          "default": [],
          "description": "Saved publishing profiles (name, transtype, outputDir, ditavalPath, additionalArgs), managed via 'DITA: Manage Publishing Profiles'. When one or more profiles exist, 'DITA: Publish' offers them alongside a one-off format pick.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Profile name shown in the publish picker."
              },
              "transtype": {
                "type": "string",
                "description": "DITA-OT output format for this profile (e.g. html5, pdf)."
              },
              "outputDir": {
                "type": "string",
                "description": "Output directory override for this profile. Leave unset to use ditacraft.outputDirectory."
              },
              "ditavalPath": {
                "type": "string",
                "description": "Path to a .ditaval file to filter this profile's output. Leave unset for no filtering."
              },
              "additionalArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Extra DITA-OT command-line arguments for this profile only."
              }
            },
            "required": [
              "name",
              "transtype"
            ]
          },
          "order": 42
        },
        "ditacraft.lastUsedPublishingProfile": {
          "type": "string",
          "default": "",
          "description": "Internal: name of the most recently used publishing profile, so the publish picker can surface it first. Managed automatically — not intended for manual editing.",
          "order": 43
        },
        "ditacraft.templatesPath": {
          "type": "string",
          "default": "",
          "description": "Path to a directory of .dita/.ditamap/.bookmap template files (supports ${workspaceFolder}). A template named e.g. topic.dita, concept.dita, task.dita, reference.dita, map.ditamap, or bookmap.bookmap is used by 'DITA: Create New Topic/Map/Bookmap' instead of the built-in skeleton when present. Placeholders: {{title}}, {{id}}, {{author}}, {{date}}. Leave empty to always use the built-in skeletons.",
          "order": 44
        },
        "ditacraft.templateAuthor": {
          "type": "string",
          "default": "",
          "description": "Value substituted for the {{author}} placeholder in custom templates (ditacraft.templatesPath). Leave empty to leave {{author}} unsubstituted.",
          "order": 45
        }
      }
    },
    "snippets": [
      {
        "language": "dita",
        "path": "./snippets/dita.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "compile": "npm run check-types && npm run esbuild-base -- --sourcemap",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:graph": "node scripts/generate-graph.js --watch",
    "graph": "node scripts/generate-graph.js",
    "okf": "node scripts/generate-okf-knowledge.js",
    "package": "vsce package",
    "esbuild-base": "node esbuild.js",
    "build-standalone": "node esbuild-standalone.js",
    "check-types": "tsc --noEmit && tsc --noEmit --project server/tsconfig.json",
    "pretest": "npm run compile-tests && npm run lint",
    "compile-tests": "tsc -p ./",
    "lint": "eslint",
    "test": "node ./out/test/runTest.js",
    "test:mcp": "cd mcp && npx tsc -p test/tsconfig.json && npx mocha \"out/test/mcp/test/*.test.js\" \"out/test/mcp/test/**/*.test.js\" --ui tdd --timeout 30000",
    "coverage": "npx c8 npm test",
    "coverage:check": "npx c8 check-coverage",
    "coverage:report": "npx c8 report --reporter=html --reporter=text --reporter=lcov"
  },
  "c8": {
    "include": [
      "out/**/*.js"
    ],
    "exclude": [
      "out/test/**",
      "**/*.test.js",
      "**/*.d.ts"
    ],
    "reporter": [
      "text",
      "html",
      "lcov"
    ],
    "report-dir": "coverage",
    "temp-directory": ".c8_output",
    "clean": true,
    "all": false,
    "check-coverage": true,
    "lines": 61,
    "statements": 61,
    "functions": 63,
    "branches": 73
  },
  "nyc": {
    "_NOTE": "nyc does not work with VS Code extension tests - use c8 instead",
    "extends": "@istanbuljs/nyc-config-typescript",
    "include": [
      "out/**/*.js"
    ],
    "exclude": [
      "out/test/**",
      "out/**/*.test.js"
    ],
    "reporter": [
      "text",
      "html",
      "lcov"
    ],
    "all": true,
    "report-dir": "coverage",
    "temp-dir": ".nyc_output",
    "check-coverage": true,
    "lines": 70,
    "statements": 70,
    "functions": 70,
    "branches": 70
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@sentropic/graphify": "^0.17.1",
    "@types/mocha": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/sinon": "^22.0.0",
    "@types/vscode": "^1.134.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.0",
    "glob": "^13.0.1",
    "mocha": "^11.8.0",
    "npm-run-all": "^4.1.5",
    "nyc": "^18.0.0",
    "sinon": "^22.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xmldom/xmldom": "^0.9.12",
    "fast-xml-parser": "^5.11.1",
    "openai": "^7.8.0",
    "typesxml": "^2.5.0",
    "vscode-languageclient": "^10.1.0"
  },
  "overrides": {
    "serialize-javascript": ">=7.0.5",
    "diff": ">=8.0.3"
  }
}
